# 可选：运行模式（设 "production" 时强制使用远程沙盒，禁止本地回退执行代码）
SPECTRA_ENV=

# 可选：Access Code 鉴权（不设则跳过鉴权，所有 API 开放访问）
SPECTRA_ACCESS_CODE=

# 必填：DashScope / Qwen OpenAI 兼容接口 Key
DASHSCOPE_API_KEY=

# 可选：E2B 沙盒执行 Key
E2B_API_KEY=

# 可选：E2B 自定义模板 ID
# 不配置时默认使用官方模板 code-interpreter-v1
# 若你已执行 `python build_template.py`，请把这里改成输出的模板名
E2B_TEMPLATE_ID=langgraph-data-analysis

# 可选：E2B sandbox 生命周期超时（秒）。SDK 默认 300s，对长任务（thinking + executor + validator + fixer）远不够。
# 默认 1800（30 分钟）。每次 run_code 之前会自动续期。
SPECTRA_E2B_TIMEOUT=1800

# 可选：legacy executor_impl 单次 run_code 的整体等待超时（秒）。
# 默认 600（10 分钟）。之前是 30s，导致 E2B 几乎必然超时回退本地。
SPECTRA_E2B_RUN_TIMEOUT=600

# 可选：任务状态保留时长（秒）
TASK_TTL_SECONDS=86400

# 可选：任务最大保留数量
MAX_TASKS=500

# 可选：预警最大保留数量
MAX_ALERTS=200
